{
  "name": "full-stack-ts-agents",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "supabase",
    "playwright"
  ],
  "scripts": {
    "dev": "run-p dev:client dev:server",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "lint": "run-s lint:client lint:server lint:supabase lint:playwright",
    "lint:client": "npm run lint --workspace client",
    "lint:server": "npm run lint --workspace server",
    "lint:supabase": "npm run lint --workspace supabase",
    "lint:playwright": "npm run lint --workspace playwright",
    "test": "run-s test:client test:server",
    "test:client": "npm run test --workspace client",
    "test:server": "npm run test --workspace server",
    "test:coverage": "run-s test:coverage:client test:coverage:server",
    "test:coverage:client": "npm run test:coverage --workspace client",
    "test:coverage:server": "npm run test:coverage --workspace server",
    "gh:workflow": "node ./scripts/gh-workflow.js",
    "analyze:playwright": "npm run analyze --workspace playwright --",
    "crawl:playwright": "npm run crawl --workspace playwright --",
    "refactor:verify": "run-s lint test:coverage"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5"
  }
}
